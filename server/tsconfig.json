{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["../src/*"]
    },

    /* Typecheck-only config (noEmit): bundler resolution so the frontend
       tree's `@/` alias imports resolve; at runtime Node strips types and
       only ever loads files whose imports carry explicit `.ts` extensions. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "scripts"]
}
